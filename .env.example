# Copy to .env for local development (server.js doesn't auto-load .env files;
# either `export` these yourself or add a one-line dotenv require if you want
# that convenience locally). On Render, set these as real environment
# variables in the dashboard — see render.yaml, which sets some of these
# automatically if you deploy via Blueprint.

# Secret used to sign JWTs. Render's blueprint auto-generates this for you.
# If setting manually, use a long random string — never reuse this example.
TROTHEN_JWT_SECRET=replace-with-a-long-random-string

# Where the JSON datastore lives. Leave unset for local dev (defaults to
# ./data next to the code). On Render, this should point at the mounted
# persistent disk path, e.g. /var/data.
DATA_DIR=

# Render sets PORT automatically — you don't need to set this yourself on
# Render. Only relevant if running locally on a non-default port.
PORT=3000

# Real Postgres connection string. Leave unset for local dev (falls back to
# the JSON file store in DATA_DIR automatically — see src/db.js).
DATABASE_URL=

# SendGrid — real email delivery (verification codes, password resets,
# notifications). Leave both unset to keep test-mode (codes shown on
# screen instead of emailed).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Twilio — real SMS delivery for phone verification codes. All three are
# required together; leave unset to keep test-mode (code shown on screen
# instead of texted). NOTE: this sends via a real Twilio phone number
# (TWILIO_FROM_NUMBER), not Twilio Verify — TWILIO_VERIFY_SERVICE_SID is
# not read anywhere in this codebase as it stands.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Sign-In — the OAuth Client ID from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID, type "Web
# application"). This is not a secret — it's sent to the browser and
# embedded in the Google sign-in button — so no client secret is needed
# for this app's ID-token flow. Leave unset and the Google button simply
# doesn't render; nothing else changes.
GOOGLE_CLIENT_ID=

# Persona — identity verification for providers. Leave all three unset to
# keep the existing manual-review fallback.
PERSONA_ENVIRONMENT_ID=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Claude API key — powers the in-app AI support chat. Leave unset to keep
# the non-AI fallback.
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Leave unset to allow the default set already baked into the app.
ALLOWED_ORIGINS=

# The public URL this app is deployed at (used to build absolute links in
# emails, etc). e.g. https://trothenpro.com
APP_URL=

# Where uploaded files (photos, documents) are stored. On Render, point
# this at the mounted persistent disk path, same volume as DATA_DIR.
UPLOADS_DIR=

# Where identity verification documents (government ID photos submitted
# for manual review) are stored — a DIFFERENT folder from UPLOADS_DIR
# above. This one is never served publicly; only the document's own owner
# or a verification-team admin can retrieve a given file, through an
# authenticated route. On Render, point this at a separate subfolder of
# the same persistent disk, e.g. /var/data/private-uploads.
PRIVATE_UPLOADS_DIR=
